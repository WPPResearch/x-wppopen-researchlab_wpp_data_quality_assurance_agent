# Choose Model Backend: 0 -> ML Dev, 1 -> Vertex
GOOGLE_GENAI_USE_VERTEXAI=1

# Vertex backend config
GOOGLE_CLOUD_PROJECT='YOUR_VALUE_HERE'
GOOGLE_CLOUD_LOCATION='YOUR_VALUE_HERE'
USER_ID='user'
APP_NAME='data_science'
MEMORY_SERVICE_URI=''

BQML_RAG_CORPUS_NAME=''

CODE_INTERPRETER_EXTENSION_NAME=''

BQ_DATASET_ID=''
BQ_DATA_PROJECT_ID=''
BQ_COMPUTE_PROJECT_ID=''

DATASET_CONFIG_FILE=''

# These are the default models. Change them accordingly if you want to use different ones for the agents.
BQML_AGENT_MODEL="gemini-2.5-flash"
ROOT_AGENT_MODEL="gemini-2.5-pro"
BIGQUERY_AGENT_MODEL="gemini-2.5-flash"
ANALYTICS_AGENT_MODEL="gemini-2.5-flash"
BASELINE_NL2SQL_MODEL="gemini-2.5-flash"
REPORT_AGENT_MODEL="gemini-2.5-flash"

ARTIFACT_AGENT_MODEL="gemini-2.5-flash"
COMPARISON_AGENT_MODEL="gemini-2.5-flash"
AUDITOR_AGENT_MODEL="gemini-2.5-flash"

ARTIFACT_BUCKET_NAME=''

# Disable OTLP trace exporter (silences "API key must be at least 40 characters" errors)
OTEL_TRACES_EXPORTER=none

# Optional configurations
WANDB_API_KEY=''
WANDB_PROJECT_ID=''
SESSION_SERVICE_URI=''
NL2SQL_METHOD='BASELINE'
ALLOYDB_AGENT_MODEL='gemini-2.5-flash'
ALLOYDB_TOOLSET=''
MCP_TOOLBOX_HOST=''
MCP_TOOLBOX_PORT=''
AGENT_URL=''
